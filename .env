# Copy this file to .env and fill in your values.
# Get a free Groq API key at https://console.groq.com/keys

# --- LLM (Groq, free tier) ---
GROQ_API_KEY="fill your API"
GROQ_MODEL=openai/gpt-oss-120b

# --- Data / DB ---
CSV_PATH=data/support_tickets.csv
DATABASE_URL=sqlite:///data/tickets.db

# --- Anomaly detection thresholds ---
HIGH_PRIORITY_AGE_HOURS=24
IQR_MULTIPLIER=1.5

# --- Business rule: what counts as "unresolved" ---
# open_only | not_resolved  (not_resolved = Open or Escalated)
UNRESOLVED_DEFINITION=not_resolved

# --- Demo override for "now" (optional) ---
# This dataset is static, dated Jan-Mar 2024. Relative-date questions
# ("this month", "this week") and anomaly ages are computed against the
# REAL current time by default. Uncomment and set this to make the system
# behave as if "today" were a date inside the dataset's range, for demos:
# AS_OF_DATE=2024-03-15

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit UI ---
API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501
